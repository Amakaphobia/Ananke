;
; Systemd
;


% systemd, common

; This context exists primarily to provide shared variables.

$ unit: systemctl list-unit-files --type=service --no-legend | awk '{print $1}'


% systemd, status
@ systemd, common

# Show the status of a systemd service
systemctl status <unit>


% systemd, restart
@ systemd, common

# Restart a systemd service
sudo systemctl restart <unit>


% systemd, scope, dependency

# Show service status in either system or user scope
systemctl <scope_flag> status <unit>

$ scope: printf '%s\n' system user --- --prevent-extra
$ scope_flag: if [ "$scope" = user ]; then printf '%s\n' --user; else printf '%s\n' ''; fi
$ unit: if [ "$scope" = user ]; then systemctl --user list-unit-files --type=service --no-legend; else systemctl list-unit-files --type=service --no-legend; fi | awk '{print $1}'


;
; journal
;


% journal, systemd
@ systemd, common

# Follow logs for a systemd service
journalctl -fu <unit>


% journal, priority

# Show journal entries at or above a priority
journalctl -p <priority>

$ priority: printf '%s\n' emerg alert crit err warning notice info debug --- --prevent-extra
